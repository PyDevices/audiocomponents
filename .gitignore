# Shared minimum (PyDevices package repos)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
*.pyd

# Testing & Lint caches
.pytest_cache/
.ruff_cache/

# Cursor IDE throwaways (do not ignore the whole .cursor/ tree)
.cursor/debug*
.cursor/plans/

# Reference material for the accuracy program: captures and papers are
# analyzed, never shipped or redistributed (vision section 4 tier 1) --
# local only, whatever their license.
.reference-captures/

# The alias-floor kit's scratch: material, per-board renders and the raw
# rows, all regenerable by tools/alias_floor/. The published numbers live in
# docs/effects-alias-floor.json.
tools/alias_floor/work/
