    "bias": 0.0,
    "post_gain": 0.5,
    "mix": 1.0,
    "probe_level": "full scale (32767) sine",
    "note": "pre_gain 1.0 into a curve that clips at a quarter of full scale is 12 dB into a hard clip - harder than any drive dossier's own probe, which specify -6 or -20 dBFS."
